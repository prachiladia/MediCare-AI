{
  "name": "ai-medicine-reminder-functions",
  "version": "1.0.0",
  "description": "Backend (Firebase Cloud Functions) for AI Medicine Reminder app",
  "main": "src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^5.0.1",
    "express-rate-limit": "^7.4.0",
    "joi": "^17.13.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.3.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "private": true
}

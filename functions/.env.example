# Copy this file to .env for LOCAL EMULATOR use only.
# NEVER put real secrets in .env.example or commit a real .env file.
# For deployed functions, set these with Firebase secrets instead (see README).

# Anthropic API key used by the AI assistant endpoint (/ai/chat)
AI_API_KEY=YOUR_ANTHROPIC_API_KEY

# Firebase Web API key, used ONLY for the optional server-side
# /auth/login endpoint (Identity Toolkit REST call). Found in
# Firebase Console > Project settings > General > Web API Key.
# This is not a secret admin credential, but keep it in env config
# rather than hardcoded anyway.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
